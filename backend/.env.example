# Backend Configuration

# Server
DATABASE_URL=sqlite:///./ariescan.db
REQUEST_TIMEOUT_SECONDS=15
MAX_TEST_CASES_PER_RUN=100
MAX_RESPONSE_BYTES=1000000
# Keep true for local target APIs. Set false for a deployed instance.
ALLOW_PRIVATE_TARGETS=true
# DELETE test cases are never generated unless explicitly enabled.
ALLOW_DESTRUCTIVE_TESTS=false

# Frontend
